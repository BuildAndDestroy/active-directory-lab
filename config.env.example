# Copy to config.env and adjust paths.

LIBVIRT_URI=qemu:///system
DISK_POOL=/var/lib/libvirt/images/ad-kvm-lab
NETWORK=ad-lab

# Full Windows Server Standard or Datacenter evaluation (2019 or 2022).
# Do NOT use SERVERHYPERCORE / Hyper-V Server for domain controllers.
WIN_SERVER_ISO=/var/lib/libvirt/iso/Windows/SERVER_EVAL_x64FRE_en-us.iso

# Workstation (Win10 21H1 is already on this host)
WIN10_ISO=/var/lib/libvirt/iso/Windows/Win10_21H1_English_x64.iso

KALI_ISO=/var/lib/libvirt/iso/Kali/kali-linux-rolling-live-xfce-amd64.iso

# https://fedorapeople.org/groups/virt/virtio-win/direct-downloads/stable-virtio/
VIRTIO_ISO=/var/lib/libvirt/iso/Windows/virtio-win.iso
